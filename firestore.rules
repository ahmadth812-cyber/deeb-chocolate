rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /orders/{docId}       { allow read, write: if isAdmin(); }
    match /customers/{docId}    { allow read, write: if isAdmin(); }
    match /products/{docId}     { allow read, write: if isAdmin(); }
    match /inventory/{docId}    { allow read, write: if isAdmin(); }
    match /regions/{docId}      { allow read, write: if isAdmin(); }
    match /expenses/{docId}     { allow read, write: if isAdmin(); }
    match /campaigns/{docId}    { allow read, write: if isAdmin(); }
    match /coupons/{docId}      { allow read, write: if isAdmin(); }
    match /trash/{docId}        { allow read, write: if isAdmin(); }
    match /certificates/{docId} { allow read, write: if isAdmin(); }
    match /settings/{docId}     { allow read, write: if isAdmin(); }
    match /notes/{docId}        { allow read, write: if isAdmin(); }
    match /events/{docId}       { allow read, write: if isAdmin(); }

    match /activityLog/{docId} {
      allow read, create: if isAdmin();
      allow update, delete: if false;
    }

    match /flavors/{docId}      { allow read, write: if isAdmin(); }
    match /freelancers/{docId}  { allow read, write: if isAdmin(); }
    match /projects/{docId}     { allow read, write: if isAdmin(); }
    match /receivables/{docId}  { allow read, write: if isAdmin(); }
    match /b2bLeads/{docId}     { allow read, write: if isAdmin(); }

    // Suppliers / procurement ERP
    match /suppliers/{docId}            { allow read, write: if isAdmin(); }
    match /supplierOrders/{docId}       { allow read, write: if isAdmin(); }
    match /supplierPriceHistory/{docId} { allow read, write: if isAdmin(); }
    match /stockMovements/{docId}       { allow read, write: if isAdmin(); }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
